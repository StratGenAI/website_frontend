# Web3Forms — free form backend (replaces Supabase for contact/session/product forms)
# 1. Go to https://web3forms.com → Create Access Key (free)
# 2. Copy key below into .env.local
WEB3FORMS_ACCESS_KEY=your_access_key_here

# Optional: email via Resend (product inquiry API also supports this)
# RESEND_API_KEY=

# Site URL (SEO)
# NEXT_PUBLIC_SITE_URL=https://stratgenai.in
